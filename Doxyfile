# Мінімальна конфігурація Doxygen для проєкту Dungeon Game.
# Документує лише Qt-незалежну бібліотеку core (доменну логіку);
# Qt-шар ui навмисно не входить до згенерованої документації, оскільки
# вимагає встановленого Qt SDK для коректного парсингу макросів moc/Q_OBJECT.
#
# Запуск локально:   doxygen Doxyfile
# Результат:         docs/html/index.html

PROJECT_NAME           = "Dungeon Game"
PROJECT_BRIEF          = "Покрокова рольова гра з підземеллям (рефакторинг: Qt-незалежне ядро + тонкий UI-адаптер)"
OUTPUT_LANGUAGE        = Ukrainian
OUTPUT_DIRECTORY       = docs

INPUT                  = core/include README.md Glossary.md Report_Analysis.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = README.md
FILE_PATTERNS          = *.hpp *.h *.md

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

GENERATE_HTML          = YES
GENERATE_LATEX         = NO

HAVE_DOT               = NO
UML_LOOK               = NO

QUIET                  = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES

SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
